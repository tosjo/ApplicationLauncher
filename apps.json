{
  "version": "1.0",
  "apps": [
    {
      "id": "chip-writer",
      "name": "ChipWriter",
      "description": "NFC chip writer with Compose Desktop UI",
      "path": "..\\ChipWriter",
      "command": "gradlew.bat :ui:run",
      "color": "#2D3748",
      "group": "Smart Card",
      "tags": ["kotlin", "compose", "nfc"],
      "url": "https://github.com/tosjo/ChipWriter"
    },
    {
      "id": "chip-reader",
      "name": "ChipReader",
      "description": "NFC chip reader with Compose Desktop UI",
      "path": "..\\ChipReader",
      "command": "gradlew.bat :ui:run",
      "color": "#1A365D",
      "group": "Smart Card",
      "tags": ["kotlin", "compose", "nfc"],
      "url": "https://github.com/tosjo/ChipReader"
    },
    {
      "id": "chip-applet-writer",
      "name": "ChipAppletWriter (legacy)",
      "description": "Legacy eMRTD applet writer — now integrated into ChipWriter. Swing GUI for writing to JavaCard via PC/SC or simulator",
      "path": "..\\ChipAppletWriter",
      "command": "gradlew.bat runWriter",
      "color": "#4A1D6A",
      "group": "Smart Card",
      "tags": ["java", "swing", "javacard"],
      "url": "https://github.com/tosjo/ChipAppletWriter"
    },
    {
      "id": "ml-visualiser",
      "name": "MLVisualiser",
      "description": "Machine learning visualiser — FastAPI backend + React frontend",
      "path": "..\\MLVisualiser",
      "command": ".venv\\Scripts\\python.exe scripts\\start_fullstack.py",
      "color": "#553C9A",
      "group": "Tools",
      "tags": ["python", "react", "fastapi"],
      "url": "https://github.com/tosjo/MLInspector",
      "ports": [
        {"port": 8000, "label": "API"},
        {"port": 5173, "label": "Frontend"}
      ]
    },
    {
      "id": "cvc-reader",
      "name": "CVCReader",
      "description": "Card Verifiable Certificate reader with Compose Desktop UI",
      "path": "..\\CVCReader",
      "command": "gradlew.bat run",
      "color": "#1A4D2E",
      "group": "Certificate",
      "tags": ["kotlin", "compose"],
      "url": "https://github.com/tosjo/CVCReader"
    },
    {
      "id": "signumca",
      "name": "SignumCA",
      "description": "Certificate Authority — HSM simulator + WildFly + React UI (dev stack)",
      "path": "..\\SignumCA",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\start-dev.ps1",
      "color": "#7B341E",
      "group": "Certificate",
      "tags": ["java", "wildfly", "react", "pki"],
      "url": "https://github.com/tosjo/SignumCA",
      "ports": [
        {"port": 5180, "label": "UI"},
        {"port": 8080, "label": "API"},
        {"port": 9990, "label": "WildFly"}
      ]
    }
  ]
}
